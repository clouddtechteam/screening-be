    <script>
        $(document).ready(function () {

            $('#ShowMoreId').css("display", "none");
            $('#ShowLessId').css("display", "none");
            $('.unpagelinks li.link').css("display", "none");

            var currentCount = 10;
            var NoOfLinks = 210;
            /* Get all li elements into array */
            var links = [];
            $('.link').each(function () {
                links.push($(this));
            });
            console.log(links);
            console.log(links.length);
            /* If Links is more than 10 Show button and 10 links only */
            if (NoOfLinks > 10) {
                for (i = 0; i < currentCount; i++) {
                    if (links[i] != undefined) {
                        links[i].css('display', 'block');
                    }
                }
                $('#ShowMoreId').css('display', 'block');
            } else {
                for (i = 0; i < currentCount; i++) {
                    if (links[i] != undefined) {
                        links[i].css('display', 'block');
                    }
                }
            }
            /* When click into show more */
            $('#ShowMoreId').click(function (e) {
                e.preventDefault();
                if (NoOfLinks > currentCount) {
                    currentCount += 10;
                    if (currentCount >= NoOfLinks) {
                        currentCount = NoOfLinks;
                        $('#ShowMoreId').css('display', 'none');
                        $('#ShowLessId').css('display', 'block');
                    }

                    for (i = 0; i < currentCount; i++) {
                        links[i].css('display', 'block');
                    }
                }
            })

            $('#ShowLessId').click(function (e) {
                debugger;
                e.preventDefault();
                if (NoOfLinks >= 20) {
                    currentCount -= 10;

                    if (currentCount > 10) {
                        LinksToShow(currentCount);
                    } else {
                        $('#ShowMoreId').css('display', 'block');
                        $('#ShowLessId').css('display', 'none');
                        currentCount = 10;
                        LinksToShow(currentCount);
                    }

                } else {
                    currentCount = 10;
                    $('#ShowMoreId').css('display', 'block');
                    $('#ShowLessId').css('display', 'none');
                    LinksToShow(currentCount);
                }

            });

            function LinksToShow(counts) {
                links.forEach(function (item) {
                    item.css('display', 'none');
                });

                for (i = 0; i < counts; i++) {
                    links[i].css('display', 'block');
                }
            }
        })
    </script>
