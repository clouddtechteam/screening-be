                                <input checked="True" class="rButtonRegisterationTypeId" data-val="true" data-val-length="The Registration Type can&#39;t be longer than 100 characters long." data-val-length-max="100" data-val-required="The &quot;Registration Type&quot; field is required" id="IndividualRegisteration" name="RegisterationType" onchange="ValidateRegisterationType()" type="radio" value="IndividualRegisteration" />
                                <span class="checkmark"></span>
                            </label>
                        </div>
                        <div class="radio">
                            <label class="radio-container">
