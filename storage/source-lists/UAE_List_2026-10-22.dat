<script>
    function RunSubscriptionValidation() {
        ValidateOtherTypeOfBussiness();
        ValidateRegisterationType();
    }

    function ValidateOtherTypeOfBussiness() {
        var TypeOfBusinessText = $("#TypeOfBusiness option:selected").text();
        if (TypeOfBusinessText !== undefined && TypeOfBusinessText !== "" && TypeOfBusinessText.toLowerCase().indexOf("other") > -1) {
            $('#OtherTypeOfBussinessDiv').show();
        } else {
            $('#OtherTypeOfBusiness').val('');
            $('#OtherTypeOfBussinessDiv').hide();
        }
    }

    function OnSuccessSubmitSubscription() {
        //$('#unmodal').modal('hide');
        $('#contentDivIdFormDiv').hide();
        $('#SucessModal').show();
        $("#SameRecEmailErr").hide();
    }

    function ValidateRegisterationType() {
        var value = $('input[name="RegisterationType"]:checked').val();
        if (value === "IndividualRegisteration") {
            document.getElementById('RecipientNameEnLabel').innerHTML = 'Personal Name English';
            document.getElementById('RecipientNameARLabel').innerHTML = 'Personal Name Arabic';
            $("form").removeData("validator");
            document.getElementById("RecipientNameEnInputID").setAttribute("data-val-required", "The &quot;Personal Name English&quot; field is required");
            document.getElementById("RecipientNameArInputID").setAttribute("data-val-required", "The &quot;Personal Name Arabic&quot; field is required");

            // reapply the form's validator
            $.validator.unobtrusive.parse(document);

            $('#TypeOfBusinessSelect').removeClass('required');
        } else if (value === "CompanyRegisteration") {
            document.getElementById('RecipientNameEnLabel').innerHTML = 'Company Name English';
            document.getElementById('RecipientNameARLabel').innerHTML = 'Company Name Arabic';

            $("form").removeData("validator");
             document.getElementById("RecipientNameEnInputID").setAttribute("data-val-required", "The &quot;Company Name English&quot; field is required");
            document.getElementById("RecipientNameArInputID").setAttribute("data-val-required", "The &quot;Company Name Arabic&quot; field is required");

            // reapply the form's validator
            $.validator.unobtrusive.parse(document);

            $('#TypeOfBusinessSelect').addClass('required');
        }
    }

    $(document).ready(function () {
        $("#unsidenav-container a,#unsidenavar-container a,.admin-tabs a").click(function () {
            if ($(this).parents(".ShowSubscriptionBanner").length > 0) {
                $(".subscribe-container").show();
            } else {
                $(".subscribe-container").hide();
            }
        })

        ValidateRegisterationType();
        $("#SubscribeTriggerModal").click(function () {
            $('#RecipientNameEn').val('');
            $('#RecipientNameAr').val('');
            $('#OtherTypeOfBusiness').val('');
            $('#RegisterationType').val('');
            $('#TypeOfBusiness').val('');
            $('#OtherTypeOfBussinessDiv').hide();

            $('#RecipientEmail').val('');
            $("#SameRecEmailErr").hide();

            $('#contentDivIdFormDiv').show();
            $('#SucessModal').hide();


            $('.field-validation-error').text('');
            var url = window.location.href.toLowerCase();
            var n = url.search("ar-ae");
            if (n > 0) {
                $('#SameRecEmailErr').text('عفوا يوجد بريد الكترونى مطابق لهذا البريد الإلكترونى');
            }
            else {
                $('#SameRecEmailErr').text('The same recipient email exists.');
            }
        });
    });

    $('.SubscribeTriggerModalRegisterLink').click(function (event) {
        document.getElementById('SubscribeTriggerModal').click();
        event.preventDefault();

    });

    function OnFailure(data) {
        $("#SameRecEmailErr").show();
    }

</script></div></div>

