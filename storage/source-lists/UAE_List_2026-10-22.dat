                        <input class="form-control text-box single-line" data-val="true" data-val-length="The Company Name Arabic can&#39;t be longer than 100 characters long." data-val-length-max="100" data-val-required="The &quot;Company Name Arabic&quot; field is required" id="RecipientNameArInputID" name="RecipientNameAr" type="text" value="" />
                        <span class="field-validation-valid text-danger" data-valmsg-for="RecipientNameAr" data-valmsg-replace="true"></span>
                        
                    </div>

                    <div class="form-group">
                        <label class="control-label required" for="RecipientNameEn" id="RecipientNameEnLabel">Company Name English</label>
                        <input class="form-control text-box single-line" data-val="true" data-val-length="The Company Name English can&#39;t be longer than 100 characters long." data-val-length-max="100" data-val-required="The &quot;Company Name English&quot; field is required" id="RecipientNameEnInputID" name="RecipientNameEn" type="text" value="" />
